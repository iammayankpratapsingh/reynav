# Every environment variable the app reads, one comment each; real values are never committed.
# All of these are read in one place: src/backend/config/index.ts. The app refuses to start if any is invalid.

# --- Runtime -----------------------------------------------------------------
# When true every adapter resolves to its mock: no external call leaves the process.
# Turn this off only once real provider credentials exist.
USE_MOCK_DATA=true

# --- Session -----------------------------------------------------------------
# HMAC key for the signed session cookie. At least 32 characters. Required in production.
SESSION_SECRET=
# Name of the session cookie.
SESSION_COOKIE_NAME=reynav_session
# How long a session lasts, in seconds. Default is 7 days.
SESSION_MAX_AGE_SECONDS=604800

# --- Encryption --------------------------------------------------------------
# Key used to encrypt OAuth tokens at rest. At least 32 characters. Required in production.
ENCRYPTION_KEY=

# --- Provider selection ------------------------------------------------------
# Which implementation each capability resolves to. Ignored while USE_MOCK_DATA is true.
PROVIDER_IDENTITY=mock
PROVIDER_LOCAL_LISTING=mock
PROVIDER_SEARCH_PERFORMANCE=mock
PROVIDER_WEB_ANALYTICS=mock
PROVIDER_BOOKING_SOURCE=mock
PROVIDER_WEB_CRAWLER=mock

# --- Google OAuth ------------------------------------------------------------
# OAuth client from Google Cloud Console, used for Business Profile, Search Console and Analytics.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
